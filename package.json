{
  "name": "kimi-webbridge-dsh",
  "description": "Infrastructure plugin for dsh: provisions the kimi-webbridge daemon (auto-install with SHA-256 verification, auto-start) and registers the official upstream skill package (SKILL.md + references/, vendored from the CDN and digest-pinned) as a runtime skill. Registers a thin kimi_webbridge tool (status health check only).",
  "version": "1.4.9",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cfanmaoli/kimi-webbridge-dsh.git"
  },
  "type": "module",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "kimi",
    "webbridge",
    "browser",
    "automation",
    "skill",
    "plugin",
    "cordis"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib/index.js",
    "skill",
    "scripts",
    "README.md",
    "cordis.patch.yml"
  ],
  "scripts": {
    "check": "node --check lib/index.js && node scripts/fetch-upstream-skill.mjs --verify-local",
    "fetch-skill": "node scripts/fetch-upstream-skill.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.7 || ^0.1.1-rc.2 || ^0.1.2-rc.1 || ^0.1.5-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.7 || ^0.1.1-rc.2 || ^0.1.2-rc.1 || ^0.1.5-rc.1",
    "@deepseek-ai/schemastery": "^3.18.1"
  }
}
